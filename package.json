{
  "name": "dsh-qzone",
  "version": "1.3.1",
  "description": "QQ 空间「空友爱看」自动动态：每天最多 3 条（素材来自当天 QQ 私聊/群聊或 B 站），还会给好友动态点赞评论、回自己动态下面的留言；带设置页，参数在插件页里直接调",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakamiku/dsh-qzone.git"
  },
  "homepage": "https://github.com/kakamiku/dsh-qzone#readme",
  "bugs": {
    "url": "https://github.com/kakamiku/dsh-qzone/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./settings-remote": "./settings-remote.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "settings-remote.js",
    "README.md",
    "LICENSE",
    "icon.svg",
    "cordis.patch.yml",
    "locale/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh-qzone",
    "deepseek-harness",
    "qq",
    "qzone",
    "napcat",
    "onebot"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "ws": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
